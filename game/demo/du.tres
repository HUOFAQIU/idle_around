[sub_resource type="Resource" id="Resource_target_rule"]
script = ExtResource("5_rule")

[resource]
script = ExtResource("1_skilldef")
id = "poison_bolt"
display_name = "毒矢"
description = "对随机1名敌人造成攻击力80%的伤害，并附加中毒（每秒4点，持续5秒，可叠加）。开局蓄力4秒，之后每4秒释放一次。"
effects = Array[ExtResource("2_effect")]([SubResource("Resource_effect_damage"), SubResource("Resource_effect_dot")])
charge_effect = SubResource("Resource_effect_charge")
target_rule = SubResource("Resource_target_rule")
