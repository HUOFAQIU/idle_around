const WIDE_RANGES: Array[Vector2i] = [
	Vector2i(0x1100, 0x115F),
	Vector2i(0x2E80, 0x303E),
	Vector2i(0x3041, 0x33FF),
	Vector2i(0x3400, 0x4DBF),
