; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="idle_around"
config/version="0.1.0"
config/tags=PackedStringArray("doing", "开发中")
run/main_scene="res://Main/Cube/Scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
run/max_fps=60

[autoload]

ModLoader="*res://Scripts/mod/mod_loader.gd"
GameGlobal="*uid://d4mr5auojqyxl"
GBIS="*uid://dit4hlufoh182"
GameplayCueManager="*res://addons/GodotGAS/managers/gameplay_cue_manager.gd"
ModCueRegistrar="*res://Scripts/mod/mod_cue_registrar.gd"
CollectionDB="*uid://b76qj7km7m8ad"
CombatTelemetry="*res://Scripts/debug/combat_telemetry.gd"
SoulRuntimeDB="*res://game/battle/soul_runtime_db.gd"
Warehouse="*res://Scripts/warehouse.gd"
SaveManager="*res://Scripts/save/save_manager.gd"
GameFlow="*res://game/flow/game_flow.gd"

[display]

window/size/viewport_width=1
window/size/viewport_height=1
window/size/mode=3
window/size/borderless=true
window/size/transparent=true
window/per_pixel_transparency/allowed=true

[editor_plugins]

enabled=PackedStringArray("res://addons/GodotGAS/plugin.cfg", "res://addons/color_catalog/plugin.cfg", "res://addons/kanban_tasks/plugin.cfg", "res://addons/script-ide/plugin.cfg")

[file_customization]

folder_colors={
"res://Main/": "red",
"res://base_mods/core/souls/": "yellow"
}

