	Vector2i(0xFE30, 0xFE6F),
	Vector2i(0xFF00, 0xFF60),
	Vector2i(0xFFE0, 0xFFE6),
	Vector2i(0x1F000, 0x1FAFF),
	Vector2i(0x20000, 0x2FFFD),
	Vector2i(0x30000, 0x3FFFD),
]


static func columns(code: int) -> int:
	if code < 0x0300:
		return 1
	if _in_ranges(code, ZERO_WIDTH_RANGES):
		return 0
	if code < 0x1100:
		return 1
	if _in_ranges(code, WIDE_RANGES):
		return 2
	return 1


static func _in_ranges(code: int, ranges: Array[Vector2i]) -> bool:
	for allowed_range in ranges:
		if code < allowed_range.x:
			continue
		if code <= allowed_range.y:
			return true
	return false
