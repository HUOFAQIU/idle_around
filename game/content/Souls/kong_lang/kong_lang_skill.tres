[sub_resource type="Resource" id="Resource_query_not_dead"]
script = ExtResource("4_query")
ignore_tags = Array[StringName]([&"State.Dead"])

[sub_resource type="Resource" id="Resource_execution_damage"]
script = ExtResource("2_exec")
base_damage = 30.0
bonus_per_matching_soul = 10.0
matching_soul_types = Array[StringName]([&"Soul.types.Wolf"])

[sub_resource type="Resource" id="Resource_effect_damage"]
script = ExtResource("3_effect")
application_query = SubResource("Resource_query_not_dead")
executions = Array[ExtResource("1_exec_base")]([SubResource("Resource_execution_damage")])

[sub_resource type="Resource" id="Resource_target_rule"]
script = ExtResource("6_target")
mode = 3
max_range = 2

[resource]
script = ExtResource("5_skill")
id = "konglang"
description = "冷却 6 秒，对 2 格内最近的怪物造成 30 伤害，多重触发 2 次；每有一个狼，此魂灵 +10 点伤害。"
effects = Array[ExtResource("3_effect")]([SubResource("Resource_effect_damage")])
hit_cue_tag = &"Cue.Combat.ClawSlash"
cooldown_seconds = 1.0
cast_times = 2
target_rule = SubResource("Resource_target_rule")
metadata/_custom_type_script = "uid://ktr72cmavmyy"
