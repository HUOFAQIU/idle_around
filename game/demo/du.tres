[sub_resource type="Resource" id="Resource_effect_charge"]
resource_name = "蓄力"
script = ExtResource("2_effect")
policy = 1
duration = 4.0
granted_tags = Array[StringName]([&"State.Charging.Poison"])

[sub_resource type="Resource" id="Resource_query_not_dead"]
script = ExtResource("4_query")
ignore_tags = Array[StringName]([&"State.Dead"])

[sub_resource type="Resource" id="Resource_modifier_damage"]
script = ExtResource("3_modifier")
attribute_name = "hp"
magnitude_calculation = 2
backing_attribute_name = "atk"
